{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "pb",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/shared/ui"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/shared/ui"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p {projectRoot}/tsconfig.lib.json --noEmit",
          "tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
