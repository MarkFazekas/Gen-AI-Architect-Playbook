{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/.nvmrc"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      }
    }
  ],
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json"]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.angular.mjs",
        "{workspaceRoot}/tools/lint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  },
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "strict": true,
      "prefix": "pb",
      "linter": "eslint",
      "unitTestRunner": "vitest-angular",
      "e2eTestRunner": "playwright"
    },
    "@nx/angular:library": {
      "style": "scss",
      "strict": true,
      "prefix": "pb",
      "linter": "eslint",
      "unitTestRunner": "vitest-analog",
      "changeDetection": "OnPush"
    },
    "@nx/angular:component": {
      "style": "scss",
      "inlineStyle": false,
      "inlineTemplate": false,
      "changeDetection": "OnPush",
      "skipTests": false
    }
  }
}
