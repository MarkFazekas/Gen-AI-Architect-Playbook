{
  "name": "@playbook/source",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "lint:styles": "stylelint \"{apps,libs}/**/*.scss\"",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:lint-rules": "node --test tools/lint-rules/",
    "build": "nx run-many -t build",
    "e2e": "nx run-many -t e2e",
    "knip": "knip",
    "audit": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=critical",
    "quality": "nx sync:check && nx format:check && nx run-many -t lint typecheck test build size && npm run test:lint-rules && npm run lint:styles && npm run knip && npm run audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.1",
    "@analogjs/vitest-angular": "2.8.1",
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "22.2.3",
    "@swc/helpers": "~0.5.18",
    "@types/node": "26.6.5",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.3.11",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-rxjs-x": "1.0.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "husky": "9.1.7",
    "jsdom": "^27.1.0",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-order": "8.1.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "rxjs": "~7.8.0",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,mjs,mts,yml,yaml}": [
      "prettier --write"
    ]
  }
}
